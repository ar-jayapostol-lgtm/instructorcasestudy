@model Instrutorcasestudy.Models.Instructor

@{
    ViewData["Title"] = "Delete Instructor";
}

<div class="container mt-4">
    <h3>Are you sure you want to delete this instructor?</h3>
    <dl class="row mt-3">
        <dt class="col-sm-2">Major</dt>
        <dd class="col-sm-10"><strong>@Model.Major</strong></dd>

        <dt class="col-sm-2">Email Address</dt>
        <dd class="col-sm-10"><strong>@Model.EmailAddress</strong></dd>

        <dt class="col-sm-2">Contact Number</dt>
        <dd class="col-sm-10"><strong>@Model.ContactNumber</strong></dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" name="instructorId" value="@Model.InstructorId" />
        <button type="submit" class="btn btn-danger">Confirm Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>