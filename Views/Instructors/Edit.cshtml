@model Instrutorcasestudy.Models.Instructor

@{
    ViewData["Title"] = "Edit Instructor";
}

<div class="container mt-4">
    <h2>Edit Instructor</h2>
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="InstructorId" />

        <div class="mb-2"><label class="form-label">Full Name</label><input asp-for="FullName" class="form-control" /></div>
        <div class="mb-2"><label class="form-label">Age</label><input asp-for="Age" class="form-control" /></div>
        <div class="mb-2"><label class="form-label">Address</label><input asp-for="Address" class="form-control" /></div>
        <div class="mb-2"><label class="form-label">Designation</label><input asp-for="Designation" class="form-control" /></div>
        <div class="mb-2"><label class="form-label">Gender</label><input asp-for="Gender" class="form-control" /></div>
        <div class="mb-2"><label class="form-label">Major</label><input asp-for="Major" class="form-control" /></div>
        <div class="mb-2"><label class="form-label">Bachelor Degree</label><input asp-for="BachelorDegree" class="form-control" /></div>
        <div class="mb-2"><label class="form-label">Email Address</label><input asp-for="EmailAddress" class="form-control" /></div>
        <div class="mb-3"><label class="form-label">Contact Number</label><input asp-for="ContactNumber" class="form-control" /></div>

        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>